# Copy to .env on the server and fill in the real values. Never commit the real file.

APP_NAME=Autoclaw
APP_ENV=production
APP_KEY=                      # php artisan key:generate
APP_DEBUG=false               # must stay false: true leaks stack traces and secrets
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Browser origins allowed to call the API (comma separated, no trailing slash)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autoclaw
DB_USERNAME=autoclaw
DB_PASSWORD=

# Login tokens expire after this many minutes (10080 = 7 days). Users are asked to log in again.
SANCTUM_EXPIRATION=10080

BCRYPT_ROUNDS=12

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Shop verification
PAYSTACK_SECRET_KEY=          # server-side only; resolves bank account names. Leave empty to review bank details by hand.
MARKETPLACE_REQUIRE_VERIFIED=false   # true = only verified shops' products are shown to the public
